              <span class="Itxt">LUGAR DE REUNIÓN (SI CORRESPONDE)</span><br/><span class="Itxt">PUEBLO/PUEBLO</span><p></p>
  - name: MICS7WM.VW35G11N
    conditions:
      - questionText:
          EN:
