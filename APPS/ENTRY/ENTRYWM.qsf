              <span style="color: rgb(0, 0, 255);">MEET UP LOCATION (IF APPLICABLE)</span><br style="color: rgb(0, 0, 255);"/><span style="color: rgb(0, 0, 255);">REGION</span><p></p>
          ES:
            format: HTML
            text: |
              <span style="color: rgb(0, 0, 255);">UBICACIÓN DE REUNIÓN (SI CORRESPONDE)</span><br style="color: rgb(0, 0, 255);"/><span style="color: rgb(0, 0, 255);">REGIÓN</span><p></p>
  - name: MICS7WM.MH49AB8N
    conditions:
      - questionText:
