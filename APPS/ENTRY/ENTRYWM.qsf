            format: HTML
            text: |
              <p><span class="Qnum">BH9. </span><span class="Qtxt">How old was <span class="REF">~~BH1~~</span> when he died?</span></p>
              <p><span class="Itxt">If '1 year', probe: </span><span class="Qtxt">How many months old was <span class="REF">~~BH1~~</span>?</span></p>
              <p><span class="Itxt">Record days if less than 1 month; record months if less than 2 years; or years.</span></p>
          ES:
            format: HTML
            text: |
              <p><span class="Qnum">BH9. </span><span class="Qtxt">¿Qué edad tenía <span class="REF">~~BH1~~</span> cuando murió?</span></p>
              <p><span class="Itxt">Si '1 año', indague: </span><span class="Qtxt">¿Cuántos meses tenía <span class="REF">~~BH1~~</span>?</span></p>
              <p><span class="Itxt">Registrar días si es menos de 1 mes; registrar meses si es inferior a 2 años; o años.</span></p>
      - logic: BH3=2
        questionText:
