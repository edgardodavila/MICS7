          ES:
            format: HTML
            text: |
              <p><span class="Qnum">BH9. </span><span class="Qtxt">¿Qué edad tenía <span class="REF">~~BH1~~</span> cuando murió?</span></p>
              <p><span class="Itxt">Si '1 año', indague: </span><span class="Qtxt">¿Cuántos meses tenía <span class="REF">~~BH1~~</span>?</span></p>
              <p><span class="Itxt">Registrar días si es menos de 1 mes; registrar meses si es inferior a 2 años; o años.</span></p>
  - name: MICS7WM.BH10
    conditions:
      - logic: curocc() = 1
        questionText:
          EN:
            format: HTML
            text: |
              <p><span class="Qnum">BH10. </span><span class="Qtxt">Were there any other live births before <span class="REF">~~BH1~~</span>, including any children who died after birth?</span></p>
          ES:
            format: HTML
            text: |
              <p><span class="Qnum">BH10. </span><span class="Qtxt">¿Hubo otros nacidos vivos antes de <span class="REF">~~BH1~~</span>, incluidos niños que murieron después del nacimiento?</span></p>
      - logic: curocc() in 2:20
        questionText:
