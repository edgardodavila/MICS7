              <p><span style="color: rgb(0, 0, 255);">UBICACIÓN DE REUNIÓN (SI CORRESPONDE)</span></p><p><span style="color: rgb(0, 0, 255);">Distrito</span><p></p></p>
  - name: MICS7WM.MH49AB10N
    conditions:
      - questionText:
          EN:
            format: HTML
            text: |
              <p><span style="color: rgb(0, 0, 255);">MEET UP LOCATION (IF APPLICABLE)</span></p><p><span style="color: rgb(0, 0, 255);">Village/Town</span><p></p></p>
          ES:
            format: HTML
