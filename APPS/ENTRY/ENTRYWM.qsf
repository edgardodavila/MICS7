      - questionText:
          EN:
            format: HTML
            text: |
              <p><span class="Qnum">[X2] </span><span class="Qtxt">Based on the ground(s) that you just specified, have you experienced this since <span class="REF">~~yyyymmminus1~~</span>?</span></p>
