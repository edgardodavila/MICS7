        questionText:
          EN:
            format: HTML
            text: |
              <p><span class="Qnum">BH6. </span><span class="Qtxt">How old was <span class="REF">~~BH1~~</span> at his last birthday?</span></p>
              <p><span class="Itxt">Record age in completed years.</span></p>
          ES:
            format: HTML
            text: |
              <p><span class="Qnum">BH6. </span><span class="Qtxt">¿Cuántos años tenía <span class="REF">~~BH1~~</span> en su último cumpleaños?</span></p>
              <p><span class="Itxt">Registro de edad en años cumplidos.</span></p>
      - logic: BH3=2
        questionText:
