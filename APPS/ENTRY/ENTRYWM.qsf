        questionText:
          EN:
            format: HTML
            text: |
              <p><span class="Qnum">BH4. </span><span class="Qtxt">In what day, month and year was <span class="REF">~~BH1~~</span> born?</span></p><p><span class="Itxt">Probe: </span><span class="Qtxt">What is his birthday?</span></p><p></p>
          ES:
            format: HTML
            text: |
              <p><span class="Qnum">BH4.&nbsp;</span><span class="Qtxt">¿En qué día, mes y año nació<span class="REF">~~BH1~~</span>&nbsp;</span></p><p><span class="Itxt">Sonda:</span><span class="Qtxt">¿Cuál es su cumpleaños?</span></p><p></p>
      - logic: BH3=2
        questionText:
