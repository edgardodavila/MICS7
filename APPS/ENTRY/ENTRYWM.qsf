          EN:
            format: HTML
            text: |
              <span style="color: rgb(0, 0, 255);">BEST AND SAFEST WAY FOR COUNSELOR TO FIND RESPONDENT (E.G. BY PHONE, IN PERSON AT HOME/ANOTHER LOCATION):</span><p></p>
          ES:
            format: HTML
            text: |
              <span style="color: rgb(0, 0, 255);">LA MEJOR Y MÁS SEGURA FORMA PARA QUE EL CONSEJERO ENCUENTRE AL ENCUESTADO (P. ej., POR TELÉFONO, EN PERSONA EN CASA/OTRO LUGAR):</span><p></p>
  - name: MICS7WM.MH49AB7
    conditions:
      - questionText:
