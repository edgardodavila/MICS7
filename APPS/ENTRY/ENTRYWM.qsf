              <p><span class="Qnum">BH3. </span><span class="Qtxt">Is <span class="REF">~~BH1~~</span> a boy or a girl?</span></p>
          ES:
            format: HTML
            text: |
              <p><span class="Qnum">BH3. </span><span class="Qtxt">¿Es <span class="REF">~~BH1~~</span> un niño o una niña?</span></p>
  - name: BH4DATE
    conditions:
