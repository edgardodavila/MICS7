          ES:
            format: HTML
            text: |
              <p><span style="color: rgb(0, 0, 255);">Año récord.</span></p>
  - name: MICS7WM.BH5
    conditions:
      - questionText:
          EN:
            format: HTML
            text: |
              <p><span class="Qnum">BH5. </span><span class="Qtxt">Is <span class="REF">~~BH1~~</span> still alive?</span></p>
          ES:
            format: HTML
            text: |
              <p><span class="Qnum">BH5. </span><span class="Qtxt">¿Sigue vivo <span class="REF">~~BH1~~</span>?</span></p>
  - name: MICS7WM.BH6
    conditions:
