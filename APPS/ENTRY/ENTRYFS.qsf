    conditions:
      - logic: ST1LANG=11
        questionText:
          EN:
            format: HTML
            text: |
              <p><span class="Qnum">FL21B. </span><span class="Qtxt">Now I am going to ask you a few questions about what you have read.</span></p>
              <p><span class="Qnum">[C] </span><span class="Qtxt"><span class="QtxtC">Why did Moses start crying</span>?</span></p>
          ES:
            format: HTML
            text: |
              <p><span class="Qnum">FL21B. </span><span class="Qtxt">Ahora te voy a hacer algunas preguntas sobre lo que has leído.</span></p>
              <p><span class="Qnum">[C] </span><span class="Qtxt"><span class="QtxtC">¿Por qué Moisés empezó a llorar</span>?</span></p>
      - logic: ST1LANG=12
        questionText:
