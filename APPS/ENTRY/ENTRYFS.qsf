            format: HTML
            text: |
              <p><span class="Qnum">FL21L. </span><span class="Itxt">Say: </span><span class="Qtxt"><span class="QtxtC">Anne has more eggs than Jean. Anne has 3 eggs and Jean has 2</span>.</span></p>
