  - name: MICS7FS.FL21L
    conditions:
      - logic: ST2LANG=11
        questionText:
          EN:
            format: HTML
            text: |
              <p><span class="Qnum">FL21L. </span><span class="Itxt">Say: </span><span class="Qtxt"><span class="QtxtC">Anne has more eggs than John. Anne has 3 eggs and John has 2</span>.</span></p>
          ES:
