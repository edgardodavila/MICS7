            text: |
              <p><span class="Qnum">FL21L. </span><span class="Itxt">Diga: </span><span class="Qtxt"><span class="QtxtC">Ana tiene más óvulos que Juan. Anne tiene 3 huevos y John tiene 2</span>.</span></p>
      - logic: ST2LANG=12
        questionText:
