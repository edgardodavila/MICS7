questions:
  - name: MICS7HH.HH1
    conditions:
      - {}
  - name: MICS7HH.HH5D
    conditions:
      - questionText:
          ES:
            format: HTML
            text: |
              <p><span class="Qnum">﻿</span><span class="Itxt">﻿</span></p>
  - name: MICS7HH.HH5M
    conditions:
      - questionText:
          ES:
            format: HTML
            text: |
              <p><span class="Qnum">﻿</span><span class="Itxt">﻿</span></p>
  - name: MICS7HH.HH5Y
    conditions:
      - questionText:
          ES:
            format: HTML
            text: |
              <p><span class="Itxt">﻿</span></p>
  - name: MICS7HH.HH7
    conditions:
      - questionText:
