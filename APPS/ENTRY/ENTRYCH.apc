   endif;
endfor;

PROC HF12D
if $ in 0,44,66 then
	HF12M = $;
	HF12Y = $*100+$;
	skip to next
endif;

if $=notappl and  curocc()=maxocc(HF12000) then
	errmsg("Vaccine can not be empty, please enter data");
	reenter;
endif;	
PROC HF12Y
onfocus
