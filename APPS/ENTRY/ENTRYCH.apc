 endif; 
   
PROC IM2
preproc
	if addmode then
		savepartial();
	endif;

	if UB2 > 2 then
		skip to DA1
	endif; 

   //Prepare valueset of year for all the vaccines
   IM6Y_VS.clear();
	do i = UB1Y while i <= UF7Y {create labels starting on year of birth}
		IM6Y_VS.add(maketext("%d",i),i);
	enddo;
	IM6Y_VS.add(tr("NO RESPONSE"),9999);
	IM6Y_VS.add(" " ,notappl);

postproc
	if $ in 1,3 then
		skip to IM5;
	endif;

PROC IM5
preproc
	{IM4 filter}
	if IM2 = 4 then
		skip to IM11;
	endif;

postproc
	if $ = 4 then
		skip to IM11;
	endif; 



PROC IM6000

for i in im6000 do 
   if im6d(i)=notappl or visualvalue(im6y(i))=notappl then
	  reenter im6d(i);
   endif;
endfor;
PROC IM6D
onfocus;
	visualIM9=visualvalue(IM9);

postproc;	
if $ in 0,44,66 then
	IM6M = $;
	IM6Y = $*100+$;
	skip to next
endif;

if $=notappl and  curocc()=maxocc(IM6000) then
	errmsg("Vaccine can not be empty, please enter data");
	reenter;
endif;	
PROC IM6Y
onfocus
	setvalueset( @getsymbol(), IM6Y_VS );

postproc
if $ <> notappl then
	checkdates(getocclabel(im6(curocc())),IM6D,IM6M,IM6Y);
	
    // compare dates of vaccines	
 	do i=1 until i > REVSEQ.length(1)
	   if REVSEQ(i,2)=curocc() then
		  if vseq(IM6D(REVSEQ(i,1)),IM6M(REVSEQ(i,1)),IM6Y(REVSEQ(i,1)),  IM6D(REVSEQ(i,2)),IM6M(REVSEQ(i,2)),IM6Y(REVSEQ(i,2))) then
			 errmsg(2704,  getocclabel(im6(REVSEQ(i,1))), IM6D(REVSEQ(i,1)),IM6M(REVSEQ(i,1)),IM6Y(REVSEQ(i,1)),
   getocclabel(im6(curocc())),    IM6D(REVSEQ(i,2)),IM6M(REVSEQ(i,2)),IM6Y(REVSEQ(i,2)));
		  endif;
	      
	   endif
	enddo;
endif;

PROC FORMIM2
postproc;
if visualvalue (CHIMTSTMPE) = notappl then
   CHIMTSTMPE = timestamp (); 
   endif; 
PROC IM8A
preproc
	if addmode then
		savepartial();
	endif;

	{IM7 filter}
{	if (IM6BD <> 0 and 
		IM6H0D <> 0 and 
		IM6P0D <> 0 and IM6P1D <> 0 and IM6P2D <> 0 and IM6P3D <> 0 and 
		IM6I1D <> 0 and IM6I2D <> 0 and
		IM6PENTA1D <> 0 and IM6PENTA2D <> 0 and IM6PENTA3D <> 0 and 
		IM6PCV1D <> 0 and IM6PCV2D <> 0 and IM6PCV3D <> 0 and
		IM6R1D <> 0 and IM6R2D <> 0 and IM6R3D <> 0 and    
		IM6M1D <> 0 and IM6M2D <> 0 and
		IM6TD1D <> 0) then skip to DA1;
	elseif  
		(IM6BD = 66 or 
		IM6H0D = 66 or 
		IM6P0D = 66 or IM6P1D = 66 or IM6P2D = 66 or IM6P3D = 66 or 
		IM6I1D = 66 or IM6I2D = 66 or
		IM6PENTA1D = 66 or IM6PENTA2D = 66 and IM6PENTA3D = 66 or 
		IM6PCV1D = 66 or IM6PCV2D = 66 or IM6PCV3D = 66 or
		IM6R1D = 66 or IM6R2D = 66 or IM6R3D = 66 or    
		IM6M1D = 66 or IM6M2D = 66 or
		IM6TD1D = 66) then advance to IM9;		
	endif;}

	if count(IM6000 where IM6D<>0)=totocc(IM6000) then //All vaccines where applied
		skip to FORMDA;
	elseif count(IM6000 where IM6D= 66) > 0 then //There is at least on 66 (reported by the mother)
		advance to IM9;		
	endif;
	
