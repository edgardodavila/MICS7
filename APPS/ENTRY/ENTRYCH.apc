postproc
if $ <> notappl then
	checkdates(getocclabel(HF12(curocc())),HF12D,HF12M,HF12Y);
	
    // compare dates of vaccines	
 	do i=1 until i > REVSEQ.length(1)
	   if REVSEQ(i,2)=curocc() then
		  if vseq(HF12D(REVSEQ(i,1)),HF12M(REVSEQ(i,1)),HF12Y(REVSEQ(i,1)),  HF12D(REVSEQ(i,2)),HF12M(REVSEQ(i,2)),HF12Y(REVSEQ(i,2))) then
			 errmsg(2704,  getocclabel(HF12(REVSEQ(i,1))), HF12D(REVSEQ(i,1)),HF12M(REVSEQ(i,1)),HF12Y(REVSEQ(i,1)),
   getocclabel(HF12(curocc())),    HF12D(REVSEQ(i,2)),HF12M(REVSEQ(i,2)),HF12Y(REVSEQ(i,2)));
		  endif;
	      
	   endif
	enddo;
endif;

PROC HF14M
if valid(HF10H) and valid(HF10M) and valid(HF14H) and valid(HF14M) then
	if (HF10H*100+HF10M)>(HF14H*100+HF14M)then
		errmsg(2910);
		reenter
	endif;
endif;

