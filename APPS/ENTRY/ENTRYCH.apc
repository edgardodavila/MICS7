	errmsg(2803,AN4,"STANDING UP");
    lengthheight = accept ("", 
	                "Data entry error detected - enter correct value ",
	                "No data entry error. STANDING UP position confirmed");			
 if lengthheight = 1 then;
    reenter; 
endif;
endif;



