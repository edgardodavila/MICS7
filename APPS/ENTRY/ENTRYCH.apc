//April 2025: CSPro 8.0 version
{ Based on standard MICS7 Base Questionnaire for Children Under 5 7.2.2
					MICS7 ComTops - Health Insurance - U5 7.1.1
					MICS7 ComTops - Birth Registration - U5 7.1.0
					MICS7 ComTops - IYCF - U5 7.1.5
					MICS7 ComTops - Diarrhoea - U5 7.1.4
					MICS7 ComTops - ARI - U5 7.2.2
					MICS7 ComTops - Malaria - U5 7.2.4
					MICS7 Facility Based Records of Vaccinations Form 7.1.5   }
{ v 5 Mar 2025 }
{V 6 Dec 2025
	-BD8 multi responde roster added to deal with the IYCF module
	-Immunization part now is a roster 
	-Function GOTO was rebuild for easy customization and show only the started modules
}
{ --------------------------------------------------------------------------- }

PROC GLOBAL


	{ Definitions of working variables }
	alpha(26) alphavar;	    { Alpha working variable used in checking alpha vars }
	alpha(26) alphanew;     { Alpha working variable used in checking alpha vars }
	alpha(62) alphalst;     { The alphabet }

	alpha(900) strnotes;    { for editnote at the end of the interview }

	numeric zscoeff, zsr, zsb1, zsb2, zsb3, zsb4, zsb5, zsdz, zst,
	  zsdzp, zsfx, zsll, zsul, zsa, zsknot, zsi, zsj, zsk, zsl,
	  zsz, zsc, zsy1, zsy2, zsy3, zssd1, zssd2, zshta,
	  zspmed, zsv, zshac, zshap, zshaz, zswap, zswaz, zswac, zshtw,
	  zswhp, zswhz, zswhc, fhaz, fwaz, fwhz, zsflag, leapday,
	  xdays1, xdays2,
	  vcheckx, 
	  addmode, 
	  chhlth, 
	  err,
	  dich, xline, udob, ldob,
	  a, e, i, j, l, lx, n, t, x, y, z, qmark, totlen, aok, alphsize ;

	numeric cln, hhn, hasHH;
	numeric inEntry, lb, ldb, maxchild, maxd, mind, prev, xentryhw, xhintnum, xmodcent;
	numeric nopartflag;  
	numeric taskStatus; //individual task status

	numeric chsex, visualIM9;
	
	numeric selection, xx1;	

	array string daystr(7);
	string daystring, daystring3;
	
	valueset IM6Y_VS;
	numeric hwage, hwerr, weightcheck, weightcheck2, heightcheck, heightcheck2, lengthheight;

   // IMMUNIZATION: needs country customization
	{	1.In the FORMIM record, adjust the numer of occurenses of IM6 to the number of vaccines of the country (same as FORMHF in item HF12 if HF is used)
		2.In the same FORMIM, left click over the item IM6 and select Occurence labels, it display a window where you can enter the label of each vaccine (same for HF12)
		3.Modify the left columns of the rosters IM6000 with the name of the vaccines of the country (same for HF12000)
		4.Modify the REVSEQ arry below.
	}
	{Example:
	{1} "BCG",
	{2} "HepB (at birth)",
	{3} "Polio (OPV) (at birth)",
	{4} "Polio (OPV) 1",
	{5} "Polio (OPV) 2",
	{6} "Polio (OPV) 3",
	{7} "Polio (IPV) 1",
	{8} "Polio (IPV) 2",
	{9} "Pentavalent (DTPHibHepB) 1",
	{10} "Pentavalent (DTPHibHepB) 2",
	{11} "Pentavalent (DTPHibHepB) 3",
	{12} "Pneumococcal (Conjugate) 1",
	{13} "Pneumococcal (Conjugate) 2",
	{14} "Pneumococcal (Conjugate) 3",
	{15} "Rotavirus 1",
	{16} "Rotavirus 2",
	{17} "Rotavirus 3",
	{18} "MMR/MR 1",
	{19} "MMR/MR 2",
	{20} "Yellow Fever",
	{21} "Td Booster 1";
	}
	// The following array describes the vaccines to be checked for dates.  For example,
	// Polio (opv) 1 must be before to Polio (opv) 2, so one line of the cluster
	// must be used for that, indicating the roster posigion of Polio (opv)1 and Polio (opv) 2.
	// If polio (opv) 1 is in the position 4 and polio (opv) 2 is in position 8, line line with "2,8," must be added.
	// Allways the second number must be higher than the first one.
	// In this example there are 11 checks, change this number with the number of checks of the country

	array REVSEQ(11,2)=
				3,4,	// Polio (opv) at birth vs Polio (opv)1
				4,5,	// Polio (opv) 1 vs Polio (opv) 2
				5,6,	// Polio (opv) 2 vs Polio (opv) 3
				7,8,	// Polio (ipv) 1 vs Polio (ipv) 2
				9,10,	// Pentavalent 1 vs Pentavalent 2
				10,11,	// Pentavalent 2 vs Pentavalent 3
				12,13,	// Peumococcal 1 vs Pneumococcal 2
				13,14,	// Peumococcal 2 vs Pneumococcal 3
				15,16,	// Rotavirus 1 vs Rotavirus 2
				16,17,	// Rotavirus 2 vs Rotavirus 3
				18,19;	// MMR1 vs MM2

	//-------------------------------------------------------


	{ User defined functions }

	{ help function to display household roster }
	function showroster () 
		show( MICS7HH.MODHL, HL1, HL2, HL3, HL4, HL6  title( tr("Ln"), tr("Name"), tr("Relation"), tr("Sex"), tr("Age") ) );
	end;

	function showCalc()
		if getos()=10 then
			execsystem("calc"); //windows
		else
			execsystem("app:com.android.calculator2.Calculator"); //only works on some tablets
		endif;
	end;

	function showmanuals ()
		view(publicfolder+"\interviewer_manual.pdf");
    end;


	function ensureNotBlank(string value, numeric min_length = 1)	
		if length(strip(value)) < min_length then
			errmsg ("You must enter text with %d+ characters for field %s", min_length, getsymbol());
			reenter;
		endif;
	end;

	function goto()
		list string modules;
		if visualvalue(UF1)   <> notappl then modules.add("UF9: "+getlabel(MODUF)); endif; 
		if visualvalue(UB1)   <> notappl then modules.add("UB0: "+getlabel(MODUB)); endif; 
		if visualvalue(UIN1) <> notappl then modules.add("UIN1: "+getlabel(MODUIN)); endif;
		if visualvalue(BR1)   <> notappl then modules.add("BR1: "+getlabel(MODBR)); endif; 
		if visualvalue(EC1)   <> notappl then modules.add("EC1: "+getlabel(MODEC)); endif; 
		if visualvalue(UCD2A) <> notappl then modules.add("UCD2A: "+getlabel(MODUCD)); endif; 
		if visualvalue(UCF2)  <> notappl then modules.add("UCF2: "+getlabel(MODUCF)); endif;  
		if visualvalue(BD2)   <> notappl then modules.add("BD2: "+getlabel(MODBD)); endif; 
		if visualvalue(IM2)   <> notappl then modules.add("IM2: "+getlabel(MODIM)); endif; 
		if visualvalue(DA1)   <> notappl then modules.add("DA1: "+getlabel(MODDA)); endif; 
		if visualvalue(AR1)   <> notappl then modules.add("AR1: "+getlabel(MODAR)); endif; 
		if visualvalue(MC1)   <> notappl then modules.add("MC1: "+getlabel(MODMC)); endif; 
		if visualvalue(UF11H) <> notappl then modules.add("UF11H: End of interview"); endif; 
		if visualvalue(AN1)   <> notappl then modules.add("AN1: "+getlabel(MODAN)); endif; 
		if visualvalue(HF1)   <> notappl then modules.add("HF1: "+getlabel(MODHF)); endif; 

		selection = accept(tr("Go to section"),modules);
		if selection > 0 then
 		   string sectiontogo=modules(selection)[1:pos(":",modules(selection))-1];
		   move to @sectiontogo advance;
		endif;   
	end;

	function seeQuest()
	    MICS7CH.view();
	end;
	  
	{ setup basic user bar }
	function userbase();
		userbar( clear );
		userbar( add button, "<",    do("PreviousField") );
		userbar( add button, ">",    do("NextField") );
		userbar( add button, ">>|",  do("AdvanceToEnd") );
		userbar( add button, tr("Note"), do("EditNote") );
		userbar( add button, tr("Lang"), do("ChangeLanguage") );
		userbar( add button, tr("Calc"), showCalc );
		userbar( add button, tr("Section"), goto );
		userbar(add button, tr("Manuals"),  showManuals );
		userbar( add spacing, 5);  
		userbar( add button, tr("See HH roster"), showroster() );
  	    userbar( add button, tr("See Quest"), seeQuest() );
	end;

	{ valid
	Checks that a variable has a valid value.
	A valid value is less than 96 and not a special value e.g notappl/missing
	Returns: 1 if valid, 0 if not valid                                        }
	function valid(xvar);
		valid = (!special(xvar) and xvar < 96)
	end;

	{ ndjlba
	Revised function to adjust dates based on age                              }
	function ndjlba(lowera,uppera,lowerb,upperb,agetofit)
		{ calculate new possible lower bound for a = lower bound of b - age - 12 months }
		x = lowerb - 12 * (agetofit + 1);
		{ if new lower bound > upper bound then we have an inconsistency }
		if x > uppera then
			x = -1
		else
			{ if new lower bound is less than upper bound, change new lower bound to be
			lower bound of b - age - 11 months }
			if x < uppera then
				x = x + 1
			endif;
			{ if new lower bound is less than old lower bound for a, leave with old value }
			if lowera > x then
				x = lowera
			endif
		endif;
		{ return value of lower bound of a }
		ndjlba = x
	end;

	{ badspecial
	Check special answers for questions with units and numbers
	!!! make sure to correctly adjust the ranges of the
    questions involved, for the function to work properly                  }
	function badspecial( units, number )
		x = 0;
		if (units  = 9 & number <= 90) |
		   (units <> 9 & number in 90:98) |
		   (units  > 1 & number = 0  ) then
			x = 1;
		endif;
		badspecial = x;
	end;

