PROC FORMHF2
preproc
   IM6Y_VS.clear();
	do i = UB1Y while i <= UF7Y {create labels starting on year of birth}
		IM6Y_VS.add(maketext("%d",i),i);
	enddo;
	IM6Y_VS.add(tr("NO RESPONSE"),9999);
	IM6Y_VS.add(" " ,notappl);
	
postproc
