                      "text": "Dentro de los primeros 3 días después del parto, se le debe dar al niño cualquier bebida que no sea leche materna.",
                      "language": "ES"
                    }
                  ],
                  "values": [
                    {
                      "labels": [
                        {
                          "text": "YES, SOMETHING OTHER THAN BREAST MILK",
                          "language": "EN"
                        },
                        {
                          "text": "SÍ, ALGO MÁS QUE LECHE MATERNA",
                          "language": "ES"
                        }
                      ],
                      "pairs": [ { "value": "1" } ]
                    },
                    {
                      "labels": [
                        {
                          "text": "NO, ONLY BREAST MILK",
                          "language": "EN"
                        },
                        {
                          "text": "NO, SÓLO LECHE MATERNA",
                          "language": "ES"
                        }
                      ],
                      "pairs": [ { "value": "2" } ]
                    },
                    {
                      "labels": [
                        {
                          "text": "NO RESPONSE",
                          "language": "EN"
                        },
                        {
                          "text": "SIN RESPUESTA",
                          "language": "ES"
                        }
                      ],
                      "pairs": [ { "value": "9" } ]
                    }
                  ]
                }
              ]
            }
          ]
