---
fileType: Question Text
version: CSPro 8.1
languages:
  - name: ES
    label: Español
styles:
  - name: Normal
    className: normal
    css: |
      font-family: Arial;font-size: 16px;
  - name: Instruction
    className: instruction
    css: |
      font-family: Arial;font-size: 14px;color: #0000FF;
  - name: Heading 1
    className: heading1
    css: |
      font-family: Arial;font-size: 36px;
  - name: Heading 2
    className: heading2
    css: |
      font-family: Arial;font-size: 24px;
  - name: Heading 3
    className: heading3
    css: |
      font-family: Arial;font-size: 18px;
questions:
  - name: MENU_DICT.STAFF_ID
    conditions:
      - questionText:
          ES:
            format: HTML
            text: |
              <p><img src=".\Resources\Images\unicef_mics_logo.png" style="width: 200px;"><span style="font-size: 24px;">&nbsp;&nbsp;&nbsp;~~project~~</span></p><p><span style="font-size: 24px; font-family: &quot;Times New Roman&quot;;"><b><font color="#0000ff">APLICACIÓN DEL SUPERVISOR</font></b></span></p><p></p><p><span style="font-size: 14px;">&nbsp;<i><b>&nbsp;Seleccione el supervisor que usará esta tableta</b></i></span><span style="font-size: 14px;"><i><b>:</b></i></span><br></p><p><br></p><p></p>
  - name: MENU_DICT.CLUSTER
    conditions:
      - questionText:
          ES:
            format: HTML
            text: |
              <p><img src="./Resources/Images/unicef_mics_logo.png" style="width: 200px;"><span style="font-size: 24px;">&nbsp;&nbsp;&nbsp;~~project~~</span><br></p><p><span style="font-size: 24px; font-family: &quot;Times New Roman&quot;;"><b><font color="#0000ff">APLICACIÓN DEL ENTREVISTADOR</font></b></span></p><p></p><p>&nbsp; &nbsp; &nbsp;<span style="font-size: 14px;">&nbsp;&nbsp;<i><b>&nbsp;Seleccione el cluster a trabajar</b></i></span><span style="font-size: 14px;"><i><b>:</b></i></span><br></p><p></p>
  - name: MENU_DICT.SUPERVISOR_MENU
    conditions:
      - questionText:
          ES:
            format: HTML
            text: |

  - name: MENU_DICT.SYNCCENTRAL
    conditions:
      - questionText:
          ES:
            format: HTML
            text: |
              <b><span style="font-size: 24px;">SINCRONIZAR CON OFICINA CENTRAL</span></b><p></p>
  - name: MENU_DICT.INTERVIEWER_MENU
    conditions:
      - questionText:
          ES:
            format: HTML
            text: |
              <img src=".\Resources\Images\unicef_mics_logo.png" style="width: 200px;">
              <span style="font-size: 24px;">&nbsp;&nbsp;&nbsp;~~project~~</span>
              <p><span style="font-size: 24px; font-family: &quot;Times New Roman&quot;;"><b><font color="#0000ff" style="">MENÚ DEL ENTREVISTADOR</font></b></span></p>
              <p style="line-height:20%">Entrevistador: ~~staff_id~~ ~~staff_name~~</p>
              <p style="line-height:20%">Grupo ~~team~~ trabajando en cluster ~~CLUSTER~~</p>
              <p style="line-height:20%">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;&nbsp;<i><b>Opciones:</b></i></p>
              <table>
              <!-- <tbody style="background-color:lightcyan;"> -->
              <tr>
              <td style="border:none; width:1%;"><a href="#" onclick="javascript:CSPro.runLogicAsync('menuinter(1);');"><img src=".\Resources\Images\selectg.png"> </a></td>
              <td style="border:none; width:20%;"><a href="#" onclick="javascript:CSPro.runLogicAsync('menuinter(1);');"><b><span style="font-size: 18px;">Seleccionar entrevista</span></b></a></td>
              </tr>
              <tr>
              <td style="border:none"><a href="#" onclick="javascript:CSPro.runLogicAsync('menuinter(2);');"><img src=".\Resources\Images\syncint.png" style=""> </a></td>
              <td style="border:none"><a href="#" onclick="javascript:CSPro.runLogicAsync('menuinter(2);');"><b><span style="font-size: 18px;">Sincronizar</span></b></a></td>
              </tr>
              <tr>
              <td style="border:none"><a href="#" onclick="javascript:CSPro.runLogicAsync('menuinter(3);');"><img src=".\Resources\Images\reportG.png" style=""> </a></td>
              <td style="border:none"><a href="#" onclick="javascript:CSPro.runLogicAsync('menuinter(3);');"><b><span style="font-size: 18px;">Reporte del cluster</span></b></a></td>
              </tr>
              <tr>
              <td style="border:none"><a href="#" onclick="javascript:CSPro.runLogicAsync('menuinter(4);');"><img src=".\Resources\Images\fix.png" style=""> </a></td>
              <td style="border:none"><a href="#" onclick="javascript:CSPro.runLogicAsync('menuinter(4);');"><b><span style="font-size: 18px;">Corregir problemas estructurales</span></b></a></td>
              </tr>
              <tr>
              <td style="border:none"><a href="#" onclick="javascript:CSPro.runLogicAsync('menusuper(5);');"><img src=".\Resources\Images\changepsu.png" style=""> </a></td>
              <td style="border:none"><a href="#" onclick="javascript:CSPro.runLogicAsync('menusuper(5);');"><b><span style="font-size: 18px;">Cambiar de cluster</span></b></a></td>
              </tr>
              </tbody></table>
  - name: MENU_DICT.CONFIRM_DELETE
    conditions:
      - questionText:
          ES:
            format: HTML
            text: |

              <table class="table table-bordered">
               <tbody style="background-color:~~color~~;">
               <tr><td style="border:none; width:5%;"><img src="~~showimage~~" width="80" height="80">
               </td><td style="width: 95%"><b>~~line1~~</b><br><br><b><font color="#0000ff">~~line2~~</font></b><br><br>~~line3~~<br><br>~~line4~~</td></tr>
               </tbody></table>
              <p><b>¿ESTÁ SEGURO DE ELIMINAR ESTE REGISTRO?</b></p>
  - name: MENU_DICT.SELECT_INTERVIEWED
    conditions:
      - questionText:
          ES:
            format: HTML
            text: |

              <table class="table table-bordered">
               <tbody style="background-color:~~color~~;">
               <tr><td style="border:none; width:5%;"><img src="~~showimage~~" width="80" height="80">
               </td><td style="width: 95%"><b>~~line1~~</b><br><br>~~line2~~<br><br>~~line3~~<br><br>~~line4~~</td></tr>
               </tbody></table>
              <p>Seleccione una opción:</p>
  - name: MENU_DICT.CHANGELANGUAGE
    conditions:
      - logic: getos()<>20 {Windows}
        questionText:
          ES:
            format: HTML
            text: |
              <p>Pulsa el botón "Cambiar idioma" para cambiar el idioma.</p><p>Presione cualquier tecla cuando haya terminado.</p><p></p>
      - logic: getos()=20 {Andoid}
        questionText:
          ES:
            format: HTML
            text: |
              <p>Seleccione la opción "Canbiar idioma".</p><p></p><p>Avance cuando hay terminado.</p><p></p>
  - name: MENU_DICT.BYE
    conditions:
      - {}
...
