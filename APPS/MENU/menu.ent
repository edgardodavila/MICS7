  ],
  "resources": [
    {
      "path": "Resources",
      "includeInCompiledApplication": true,
      "recursive": true
    }
  ],
  "logicSettings": {
    "version": 2.0,
    "caseSensitive": {
      "symbols": false
    },
    "actionInvoker": {
      "accessFromExternalCaller": "alwaysAllow",
      "convertResultsForLogic": true
    }
  },
  "properties": {
    "askOperatorId": false,
    "autoAdvanceOnSelection": false,
    "caseTree": "off",
    "centerForms": false,
    "createListing": false,
    "createLog": false,
    "decimalMark": "dot",
    "displayCodesAlongsideLabels": false,
    "notes": {
      "delete": "all",
      "edit": "all"
    },
    "partialSave": {
      "operatorEnabled": false
    },
    "showEndCaseMessage": false,
    "showOnlyDiscreteValuesInComboBoxes": false,
    "showFieldLabels": false,
    "showErrorMessageNumbers": false,
    "showQuestionText": true,
    "showRefusals": true,
    "verify": {
      "frequency": 1,
      "start": "random"
    },
    "htmlDialogs": true,
    "paradata": {
      "collection": "none",
      "recordCoordinates": false,
      "recordInitialPropertyValues": false,
      "recordIteratorLoadCases": false,
      "recordValues": false
    },
    "useHtmlComponentsInsteadOfNativeVersions": false
  }
