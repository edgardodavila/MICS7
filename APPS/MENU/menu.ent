      "type": "main",
      "path": "menu.ent.apc"
    },
    {
      "type": "external",
      "path": "../SETTINGS.APC"
    }
  ],
  "messages": [
    "menu.ent.mgf"
  ],
  "reports": [
    {
      "name": "SUPERMENU",
      "encoding": "HTML",
      "path": "supermenu.html"
    },
    {
      "name": "INTERVMENU",
      "encoding": "HTML",
      "path": "intervmenu.html"
